# ── Configuration du backend Kobo Automation Suite ──────────────────────────
# Copiez ce fichier en .env pour le développement local.
# En PRODUCTION (Render, Railway...), configurez ces variables directement
# dans l'interface "Environment Variables" de votre service.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Kobo Automation Suite"
DEBUG=false
ENVIRONMENT=production

# ── Base de données ───────────────────────────────────────────────────────────
# ⚠️  OBLIGATOIRE EN PRODUCTION (Render, Railway...)
# Le disque Render est ÉPHÉMÈRE : si vous utilisez SQLite (défaut), les comptes
# Kobo seront PERDUS à chaque redéploiement !
#
# Obtenez votre URL de connexion sur https://console.neon.tech → votre projet
# → "Connection Details" → copier l'URL "postgresql://..."
#
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Chiffrement AES-256 (Fernet) ──────────────────────────────────────────────
# ⚠️  OBLIGATOIRE EN PRODUCTION
# Sans cette variable, une clé aléatoire est générée à chaque démarrage,
# rendant les mots de passe Kobo INDÉCHIFFRABLES après un redéploiement !
#
# Générez une clé stable avec cette commande Python :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
SECRET_KEY=VOTRE_CLE_FERNET_STABLE_ICI

# ── Google OAuth2 (optionnel) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://votre-app.onrender.com/google-callback

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL(s) du frontend autorisées à accéder au backend (séparées par des virgules)
ALLOWED_ORIGINS=https://votre-frontend.onrender.com
