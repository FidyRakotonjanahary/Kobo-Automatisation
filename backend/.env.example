# ────────────────────────────────────────────────────────────────────────────
# Kobo Automation Suite — Variables d'environnement Backend
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env (il est dans .gitignore)
# ────────────────────────────────────────────────────────────────────────────

APP_NAME="Kobo Automation Suite"
DEBUG=true
ENVIRONMENT=development

# Base de données SQLite (chemin relatif au dossier backend/)
DATABASE_URL="sqlite+aiosqlite:///./kobo_automation.db"

# ── Sécurité ──────────────────────────────────────────────────────────────
# Clé Fernet en base64 (générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Laissez vide en local (le keyring Windows sera utilisé)
SECRET_KEY=

# ── Google OAuth2 ─────────────────────────────────────────────────────────
# Laissez vide en local si vous utilisez le fichier client_secrets.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/google-callback

# ── CORS ──────────────────────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules
# En local : http://localhost:3001
# En prod  : https://votre-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:3001
